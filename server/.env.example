# ─── Bot Telegram ───────────────────────────────────────────────────────
# Crée ton bot sur https://t.me/BotFather avec /newbot
# Copie le token ici :
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─── Ton Telegram User ID ───────────────────────────────────────────────
# Lance le bot une première fois, envoie /start
# Ton ID apparaît dans la console — colle-le ici :
ALLOWED_USER_ID=123456789

# ─── GitHub Token (GitHub Models AI) ───────────────────────────────────
# Va sur https://github.com/settings/tokens
# Crée un token classique avec le scope : (aucun scope nécessaire pour Models API)
# Ou utilise un token fine-grained sans permissions
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Modèle IA (optionnel) ──────────────────────────────────────────────
# gpt-4o-mini (rapide, gratuit), gpt-4o (meilleur)
AI_MODEL=gpt-4o-mini

# ─── Port serveur web ───────────────────────────────────────────────────
PORT=5000
